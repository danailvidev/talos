# Copy to config/.env — TALOS_ENV_FILE can override this path.
# .env is gitignored at any depth. Never commit real values here.
#
# This file WINS over the environment: a token left exported in a shell profile
# must not silently beat the one you edit here. A name left empty below defers to
# the environment instead, so CI-injected secrets keep working.

# Encrypts per-developer credentials in the database, so a copied talos.db is
# not fifteen people's GitLab tokens. Generate with `openssl rand -hex 32`.
#
# Back it up with the database, and do not rotate it casually: changing it makes
# every stored credential unreadable and everyone has to set theirs again. Leave
# it empty and per-user credentials are simply off — every run uses the shared
# tokens below, which is the right setup for a single operator.
TALOS_SECRET_KEY=

# The identity tokens below are used only for install-originated work with no
# actor. Work attributed to a developer requires that developer's own credentials
# from My provider access and never falls back to these values.
#
# Everything under Settings -> Integrations in the web UI is stored in the
# database and overrides this file, so the values here are the boot-time
# defaults. Editing them still works and needs no key; editing them in the UI
# needs no shell on the host and no restart.

# Optional recovery accounts. They cannot log in unless a password is explicitly
# configured; normal users should be created under Administration → Users.
TALOS_ADMIN_PASSWORD=
TALOS_OPERATOR_PASSWORD=

# Shared token for instance-owned GitLab work. Interactive feedback never uses
# this identity: each developer stores their own api-scoped PAT under My
# provider access.
GITLAB_TOKEN=

# Self-hosted GitLab only, e.g. https://gitlab.example.com/api/v4. Empty means
# gitlab.com.
GITLAB_API_URL=

# Jira Cloud site, e.g. https://your-site.atlassian.net — no /rest path.
JIRA_BASE_URL=
# Jira Software board to mirror on My tickets. Optional when it can be inferred
# from the signed-in developer's current sprint.
JIRA_BOARD_ID=

# Jira Cloud: your account email plus an API token from
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_TOKEN=

# Azure DevOps personal access token, scope: Work Items (read).
# Note: WIQL '@Me' resolves to the token owner.
AZURE_DEVOPS_TOKEN=

# Slack OAuth app for each TALOS developer's DM/selected-channel inbox.
# Configure <your TALOS base URL>/api/auth/slack/callback as a Redirect URL and
# request these user scopes: channels:read, channels:history, groups:read,
# groups:history, im:read, im:history, mpim:read, mpim:history, users:read,
# search:read, chat:write, reactions:write, files:read, files:write,
# channels:write, groups:write, im:write, mpim:write. The reaction/file scopes
# enable message reactions and image uploads; the four conversation write scopes
# enable the optional "Mark read in Slack" setting.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# The one accepted workspace (starts with T). Connections from another workspace
# are rejected after OAuth.
SLACK_WORKSPACE_ID=
# Optional live-update transport. Enable Socket Mode and create an app-level
# token with connections:write and authorizations:read.
SLACK_APP_TOKEN=

# Slack bot token (xoxb-...), from the same Slack app's OAuth & Permissions page.
# Scope: chat:write. Used to announce releases when a release MR opens.
SLACK_BOT_TOKEN=

# Where those announcements are posted — a channel name or ID. The app has to be
# invited to it (/invite @your-app), or posting fails with 'not_in_channel'.
SLACK_RELEASE_CHANNEL=

# LogRocket API key, from Settings -> API in LogRocket. Setting it turns the
# LogRocket page on in the console.
LOGROCKET_API_KEY=

# Authenticates inbound LogRocket issue alerts. LogRocket has no API for listing
# issues, so they arrive as alerts POSTed to
# http://<host>/webhooks/logrocket/<this secret>
# — paste that URL into LogRocket -> Issues -> Alerts. The secret is the path, so
# make it long (`openssl rand -hex 32`); while it is empty every delivery is
# refused rather than accepted anonymously.
LOGROCKET_WEBHOOK_SECRET=

# Where "Create ticket & fix" files a LogRocket issue. Issue type defaults to Bug.
LOGROCKET_JIRA_PROJECT=
LOGROCKET_JIRA_ISSUE_TYPE=

# Datadog personal access token, from Personal Settings -> Access Tokens. It
# starts with `ddpat_` and is sent as `Authorization: Bearer`, which is the only
# scheme the Logs API accepts it under — an API key (32 hex) and an application
# key (40 hex) are a different credential and are not used here. Scopes needed:
# logs_read_data, logs_read_index_data. Setting it turns the Datadog page on.
DATADOG_TOKEN=

# Datadog region host, without the `api.` prefix: datadoghq.com (US1, the
# default), datadoghq.eu, us3.datadoghq.com, ddog-gov.com. A token is only valid
# in the site it was created in, so a wrong value here reads as a 401.
DATADOG_SITE=

# The log search the daily scan runs. Empty means `status:error env:prod`.
# Widening it to all environments usually multiplies the volume without adding a
# bug anybody will fix; per-service exclusions belong in the Routing panel on the
# Datadog page, where they can be changed without a restart.
DATADOG_LOG_QUERY=

# Where "Create ticket & fix" files a Datadog issue. Issue type defaults to Bug.
# A routing rule may override the project per team.
DATADOG_JIRA_PROJECT=
DATADOG_JIRA_ISSUE_TYPE=

# LLM providers. Only the configured one is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# E2E browser container networking. Empty uses Docker's default bridge network.
# Set to `host` when the corporate VPN client blocks bridge forwarding and the
# QA portal is unreachable from the container but reachable from the host.
TALOS_E2E_NETWORK=

# EKS mode. Leave TALOS_EXECUTOR unset for local Docker execution. Kubernetes
# images must be immutable ECR digest references, never mutable tags.
TALOS_EXECUTOR=
TALOS_PUBLIC_URL=
TALOS_KUBERNETES_NAMESPACE=talos
TALOS_AGENT_IMAGE=
TALOS_E2E_IMAGE=
TALOS_WORKER_SERVICE_ACCOUNT=talos-worker
TALOS_JOB_TTL_SECONDS=3600
TALOS_KUBERNETES_POLL_MS=1000
TALOS_WORKER_CPU_REQUEST=500m
TALOS_WORKER_CPU_LIMIT=2
TALOS_WORKER_MEMORY_REQUEST=1Gi
TALOS_WORKER_MEMORY_LIMIT=4Gi

# EKS E2E evidence is uploaded directly by the worker through IRSA. The control
# plane uses its own IRSA identity to list, retrieve, and expire these objects.
TALOS_ARTIFACT_BACKEND=
TALOS_ARTIFACT_S3_BUCKET=
TALOS_ARTIFACT_S3_PREFIX=talos/e2e
AWS_REGION=

# Install-specific GitLab projects. Empty uses the example-org placeholders in
# the source. Set these to your own group/project paths.
TALOS_FEEDBACK_GITLAB_PROJECT=
TALOS_E2E_SETTINGS_PROJECT=
TALOS_E2E_PROJECT=
TALOS_DEFAULT_GITLAB_PROJECT=
TALOS_DATADOG_PROJECT_PREFIX=

# Confluence page whose children are the release notes listed on Releases.
# Example: https://your-site.atlassian.net/wiki/spaces/TEAM/pages/1/Release+Notes
TALOS_CONFLUENCE_RELEASES_PAGE=

# Comma-separated GitLab pipeline schedule ids to hide from Automation discovery.
TALOS_AUTOMATION_EXCLUDED_SCHEDULE_IDS=
