{
  "name": "talos",
  "version": "0.1.0",
  "description": "Self-hosted automation platform: scheduled workflows across GitLab, Jira, Azure DevOps and Slack, with optional LLM reasoning steps.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "start": "bun run src/server.ts",
    "api:dev": "PORT=4318 bun --watch run src/server.ts",
    "test": "bun test",
    "bench": "bun run scripts/benchmark-sqlite.ts",
    "typecheck": "tsc --noEmit",
    "check:secrets": "bun run scripts/check-secrets.ts",
    "check:boundaries": "bun run scripts/check-boundaries.ts",
    "check:assistant-catalog": "bun run scripts/generate-assistant-api-catalog.ts --check",
    "check": "bun run check:assistant-catalog && bun run check:secrets && bun run check:boundaries && bun run typecheck && bun run ui:typecheck && bun test && bun run ui:build",
    "build": "bun run ui:build",
    "ui:dev": "cd web && bun run dev",
    "ui:build": "cd web && bun run build",
    "ui:typecheck": "cd web && bun x tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@casl/ability": "^7.0.1",
    "@kubernetes/client-node": "^2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "croner": "^10.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
