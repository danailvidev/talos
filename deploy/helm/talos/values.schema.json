{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "controlPlane": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "existingSecret": {
      "type": "object",
      "required": ["name", "requiredKeys", "optionalKeys"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "requiredKeys": {
          "type": "array",
          "contains": { "const": "TALOS_SECRET_KEY" },
          "uniqueItems": true
        },
        "optionalKeys": {
          "type": "array",
          "uniqueItems": true
        }
      }
    },
    "networkPolicies": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressCidrs": { "$ref": "#/definitions/cidrs" },
        "kubernetesApiCidrs": { "$ref": "#/definitions/cidrs" },
        "controlPlaneEgressCidrs": { "$ref": "#/definitions/cidrs" },
        "workerEgressCidrs": { "$ref": "#/definitions/cidrs" }
      }
    }
  },
  "definitions": {
    "cidrs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
      },
      "uniqueItems": true
    }
  }
}
