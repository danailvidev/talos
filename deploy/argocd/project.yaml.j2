apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: {{ argocd_project }}
  namespace: {{ argocd_namespace }}
  labels:
    app.kubernetes.io/part-of: talos
spec:
  description: Restricts the Talos deployment to its repository and namespace.
  sourceRepos:
    - {{ git_repository_url }}
  destinations:
    - server: {{ kubernetes_api_server }}
      namespace: {{ talos_namespace }}
  clusterResourceWhitelist: []
  namespaceResourceWhitelist:
    - group: "*"
      kind: "*"
  orphanedResources:
    warn: true
