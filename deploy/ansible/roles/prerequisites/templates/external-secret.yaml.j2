apiVersion: {{ external_secret_api_version }}
kind: ExternalSecret
metadata:
  name: {{ external_secret_name }}
  namespace: {{ talos_namespace }}
  labels:
    app.kubernetes.io/part-of: talos
spec:
  refreshInterval: {{ external_secret_refresh_interval }}
  secretStoreRef:
    kind: {{ external_secret_store_kind }}
    name: {{ external_secret_store_name }}
  target:
    name: {{ external_secret_name }}
    creationPolicy: Owner
  data:
{% for secret in external_secret_data %}
    - secretKey: {{ secret.secret_key }}
      remoteRef:
        key: {{ secret.remote_key }}
{% if secret.remote_property is defined %}
        property: {{ secret.remote_property }}
{% endif %}
{% endfor %}
